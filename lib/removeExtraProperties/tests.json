[
  {
    "description": "remove undefined properties",
    "schema": {
      "$id": "https://example.com/0",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "tests": [
      {
        "description": "When the instance contains only schema-defined properties, it should remain unchanged",
        "instance": {},
        "expected": {}
      },
      {
        "description": "When the instance contains only schema-defined properties, it should remain unchanged",
        "instance": {
          "name": "John"
        },
        "expected": {
          "name": "John"
        }
      },
      {
        "description": "When the instance contains properties not defined in the schema, those properties should be removed",
        "instance": {
          "name": "John",
          "age": 30
        },
        "expected": {
          "name": "John"
        }
      },
      {
        "description": "When the instance contains only undefined properties, all properties should be removed",
        "instance": {
          "age": 30
        },
        "expected": {}
      }
    ]
  },
  {
    "description": "remove undefined properties at all levels",
    "schema": {
      "$id": "https://example.com/1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "person": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "age": {
              "type": "number"
            }
          }
        }
      }
    },
    "tests": [
      {
        "description": "Given an empty object, nothing should be changed",
        "instance": {},
        "expected": {}
      },
      {
        "description": "Given 'person' with an empty object, nothing should be changed",
        "instance": {
          "person": {}
        },
        "expected": {
          "person": {}
        }
      },
      {
        "description": "Given a top-level property not defined by the schema, that property should be removed",
        "instance": {
          "person": {},
          "person2": "foo"
        },
        "expected": {
          "person": {}
        }
      },
      {
        "description": "Given a 'person' object containing properties not defined in its schema, those properties should be removed",
        "instance": {
          "person": {
            "name": "foo",
            "email": "foo@bar.com"
          }
        },
        "expected": {
          "person": {
            "name": "foo"
          }
        }
      },
      {
        "description": "Given an 'person' object containing only schema-defined properties, it should remain unchanged",
        "instance": {
          "person": {
            "name": "foo",
            "age": 42
          }
        },
        "expected": {
          "person": {
            "name": "foo",
            "age": 42
          }
        }
      },
      {
        "description": "Given a defined property that fails validation, it should not be removed",
        "instance": {
          "person": {
            "name": 123
          }
        },
        "expected": {
          "person": {
            "name": 123
          }
        }
      }
    ]
  },
  {
    "description": "remove undefined items from array",
    "schema": {
      "$id": "https://example.com/2",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "tests": [
      {
        "description": "When an array contains items at positions not defined by the schema, those items should be removed",
        "instance": [
          1,
          "foo",
          true,
          "bar",
          {}
        ],
        "expected": [
          1,
          "foo"
        ]
      },
      {
        "description": "When an array contains only schema-defined items, it should remain unchanged",
        "instance": [
          1,
          "foo"
        ],
        "expected": [
          1,
          "foo"
        ]
      },
      {
        "description": "When a schema-defined array item fails validation, it should not be removed",
        "instance": [
          "not a number",
          123
        ],
        "expected": [
          "not a number",
          123
        ]
      }
    ]
  },
  {
    "description": "remove undefined items from arrays recursively",
    "schema": {
      "$id": "https://example.com/3",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "prefixItems": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        }
      ]
    },
    "tests": [
      {
        "description": "When an instance is an empty array, it should remain unchanged",
        "instance": [],
        "expected": []
      },
      {
        "description": "When a nested array contains items not defined by its schema, those items should be removed",
        "instance": [
          [
            42,
            "foo",
            true
          ]
        ],
        "expected": [
          [
            42,
            "foo"
          ]
        ]
      },
      {
        "description": "When an array contains items at top-level positions not defined by the schema, those items should be removed",
        "instance": [
          [
            42
          ],
          "foo"
        ],
        "expected": [
          [
            42
          ]
        ]
      }
    ]
  },
  {
    "description": "Handle invalid schema",
    "schema": {
      "$id": "https://example.com/4",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "invalid"
    },
    "tests": [
      {
        "description": "When the schema is invalid, an error should be thrown",
        "instance": {},
        "expected": "Invalid Schema"
      }
    ]
  },
  {
    "description": "Schema with additionalProperties on object",
    "schema": {
      "$id": "https://example.com/5",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "foo": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "tests": [
      {
        "description": "If the schema defines additional properties, no properties should be removed",
        "instance": {
          "foo": 42,
          "bar": "baz"
        },
        "expected": {
          "foo": 42,
          "bar": "baz"
        }
      }
    ]
  },
  {
    "description": "Schema with additionalProperties on nested object",
    "schema": {
      "$id": "https://example.com/6",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "obj": {
          "type": "object",
          "properties": {
            "foo": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "tests": [
      {
        "description": "If a nested object schema defines additional properties, nested properties should not be removed",
        "instance": {
          "obj": {
            "foo": 42,
            "bar": "baz"
          }
        },
        "expected": {
          "obj": {
            "foo": 42,
            "bar": "baz"
          }
        }
      }
    ]
  },
  {
    "description": "Schema with items keyword on array",
    "schema": {
      "$id": "https://example.com/7",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        }
      ],
      "items": true
    },
    "tests": [
      {
        "description": "If the schema defines additional array items, no items should be removed",
        "instance": [
          1,
          "foo"
        ],
        "expected": [
          1,
          "foo"
        ]
      }
    ]
  },
  {
    "description": "Schema with items on nested array",
    "schema": {
      "$id": "https://example.com/8",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "prefixItems": [
        {
          "type": "array",
          "items": true
        }
      ]
    },
    "tests": [
      {
        "description": "If a nested array schema defines items, nested items should not be removed",
        "instance": [
          [
            1,
            "foo"
          ]
        ],
        "expected": [
          [
            1,
            "foo"
          ]
        ]
      }
    ]
  },
  {
    "description": "Schema with 'prefixItems' and 'contains'",
    "schema": {
      "$id": "https://example.com/9",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        }
      ],
      "contains": {
        "type": "string"
      }
    },
    "tests": [
      {
        "description": "values not defined by 'prefixItems' or 'items' are removed even if they satisfy contains",
        "instance": [
          42,
          "foo",
          true,
          "bar"
        ],
        "expected": [
          42
        ]
      }
    ]
  },
  {
    "description": "Schema with conditional property definitions using if/then/else",
    "schema": {
      "$id": "https://example.com/10",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "if": {
        "type": "object",
        "properties": {
          "aaa": {
            "const": 42
          }
        },
        "required": [
          "aaa"
        ]
      },
      "then": {
        "properties": {
          "bbb": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "ccc": {
            "type": "string"
          }
        }
      }
    },
    "tests": [
      {
        "description": "when 'aaa' is 42, properties not defined by the 'then' schema are removed",
        "instance": {
          "aaa": 42,
          "bbb": "foo",
          "ccc": "bar"
        },
        "expected": {
          "aaa": 42,
          "bbb": "foo"
        }
      },
      {
        "description": "when 'aaa' is present but not equal to 42, properties not defined by the 'else' schema are removed",
        "instance": {
          "aaa": 24,
          "bbb": "foo",
          "ccc": "bar"
        },
        "expected": {
          "aaa": 24,
          "ccc": "bar"
        }
      },
      {
        "description": "when 'aaa' is not present, properties not defined by the 'else' schema are removed",
        "instance": {
          "bbb": "foo",
          "ccc": "bar"
        },
        "expected": {
          "ccc": "bar"
        }
      }
    ]
  },
  {
    "description": "Schema with conditional property definitions using dependentSchemas",
    "schema": {
      "$id": "https://example.com/11",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "foo": {
          "type": "string"
        }
      },
      "dependentSchemas": {
        "foo": {
          "properties": {
            "bar": {
              "type": "number"
            }
          }
        }
      }
    },
    "tests": [
      {
        "description": "when 'foo' is present, properties not defined by the base or dependent schema are removed",
        "instance": {
          "foo": "aaa",
          "bar": 42,
          "baz": "qux"
        },
        "expected": {
          "foo": "aaa",
          "bar": 42
        }
      },
      {
        "description": "when 'foo' is not present, properties not defined by the base schema are removed",
        "instance": {
          "bar": 42,
          "baz": "qux"
        },
        "expected": {}
      }
    ]
  },
  {
    "description": "Schema with property definitions using patternProperties",
    "schema": {
      "$id": "https://example.com/12",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "patternProperties": {
        "^f": {
          "type": "string"
        }
      }
    },
    "tests": [
      {
        "description": "properties not matching any pattern are removed",
        "instance": {
          "foo": "bar",
          "baz": 42
        },
        "expected": {
          "foo": "bar"
        }
      },
      {
        "description": "when all properties are defined by patternProperties, the instance remains unchanged",
        "instance": {
          "foo": "bar"
        },
        "expected": {
          "foo": "bar"
        }
      }
    ]
  },
  {
    "description": "Schema with property definitions using '$ref'",
    "schema": {
      "$id": "https://example.com/13",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "foo": {
          "$ref": "#/$defs/foo"
        }
      },
      "$defs": {
        "foo": {
          "type": "number"
        }
      }
    },
    "tests": [
      {
        "description": "When the instance is empty, nothing is removed",
        "instance": {},
        "expected": {}
      },
      {
        "description": "properties not defined by a $ref-resolved schema are removed",
        "instance": {
          "foo": 42,
          "bar": "baz"
        },
        "expected": {
          "foo": 42
        }
      }
    ]
  },
  {
    "description": "Schema with unevaluatedProperties keywrord",
    "schema": {
      "$id": "https://example.com/14",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "unevaluatedProperties": {
        "type": "number"
      }
    },
    "tests": [
      {
        "description": "when unevaluatedProperties is present, all properties are considered defined and none are removed",
        "instance": {
          "abc": 42,
          "def": 24
        },
        "expected": {
          "abc": 42,
          "def": 24
        }
      },
      {
        "description": "properties defined by unevaluatedProperties are preserved even if they fail validation",
        "instance": {
          "abc": 42,
          "def": "bar",
          "foo": 24
        },
        "expected": {
          "abc": 42,
          "def": "bar",
          "foo": 24
        }
      }
    ]
  },
  {
    "description": "schema with unevaluatedItems keyword",
    "schema": {
      "$id": "https://example.com/15",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "unevaluatedItems": {
        "type": "number"
      }
    },
    "tests": [
      {
        "description": "items defined by unevaluatedItems are preserved even if they fail validation",
        "instance": [
          42,
          "foo",
          true
        ],
        "expected": [
          42,
          "foo",
          true
        ]
      }
    ]
  }
]